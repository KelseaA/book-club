// Prisma schema for the Book Club app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  SETUP
  VOTING
  FINALIZED
}

model Member {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  passwordHash       String
  // Bumped on password reset/change; login cookies carry the version they
  // were issued with, so bumping it signs out every existing session
  sessionVersion     Int       @default(0)
  // Admins can remove/restore members and make others admins. The club
  // always keeps at least one active admin (see services/admin.ts).
  isAdmin            Boolean   @default(false)
  // Opt-in: emails when voting opens and when the winner is announced
  emailNotifications Boolean   @default(false)
  // Set when an admin removes the member: they can't sign in and are hidden
  // from lists, but their history (votes, hosted meetings) stays intact.
  // Restoring clears it.
  removedAt          DateTime?
  // Set when the member deletes their own account. Personal details are
  // wiped at the same time; the anonymous row keeps history consistent.
  deletedAt          DateTime?
  // Address fields for profile purposes
  streetAddress      String?
  city               String?
  state              String?
  zipCode            String?
  country            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Meetings this member is hosting
  hostedMeetings      Meeting[]            @relation("HostMember")
  bookVotes           BookVote[]
  dateSelections      DateSelection[]
  feedback            Feedback[]
  joinLinksCreated    JoinLink[]
  passwordResetTokens PasswordResetToken[]
}

// One round of the book club: propose books and dates, vote, then finalize.
// Meetings don't follow the calendar (the club might meet late October, then
// December), so they're plain sequential records rather than one per month.
// At most one meeting is in SETUP/VOTING at a time.
model Meeting {
  id     Int           @id @default(autoincrement())
  status MeetingStatus @default(SETUP)

  hostMemberId Int
  host         Member @relation("HostMember", fields: [hostMemberId], references: [id])

  // Whether non-host members can see results
  resultsVisible Boolean   @default(false)
  revealedAt     DateTime?

  // Finalization fields
  finalBookOptionId Int?
  finalBookOption   BookOption? @relation("FinalBook", fields: [finalBookOptionId], references: [id])
  meetingDate       DateTime?

  // Optional snapshot of final rankings stored as plain text for archive display
  finalResultsSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookOptions BookOption[] @relation("MeetingBooks")
  dateOptions DateOption[]
  bookVotes   BookVote[]
}

model BookOption {
  id        Int     @id @default(autoincrement())
  meetingId Int
  meeting   Meeting @relation("MeetingBooks", fields: [meetingId], references: [id])

  title         String
  author        String
  notes         String?
  genres        String?
  coverImageUrl String?
  sourceUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookVoteRanks    BookVoteRank[]
  // Used when this book is the final winner
  finalForMeetings Meeting[]      @relation("FinalBook")
}

// One BookVote per member per meeting — represents their ranked ballot.
// It also marks that the member has voted (see voteController.submitVote).
model BookVote {
  id        Int     @id @default(autoincrement())
  meetingId Int
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  memberId  Int
  member    Member  @relation(fields: [memberId], references: [id])

  submittedAt DateTime @default(now())

  // Normalized ranked choices: one row per book option
  ranks BookVoteRank[]

  @@unique([meetingId, memberId]) // one ballot per member per meeting
}

// Each row represents one rank for one book in a ballot
// rank=1 is first choice, rank=2 is second, etc.
model BookVoteRank {
  id         Int      @id @default(autoincrement())
  bookVoteId Int
  bookVote   BookVote @relation(fields: [bookVoteId], references: [id])

  bookOptionId Int
  bookOption   BookOption @relation(fields: [bookOptionId], references: [id])

  rank Int // 1 = top choice

  @@unique([bookVoteId, bookOptionId])
  @@unique([bookVoteId, rank])
}

model DateOption {
  id        Int     @id @default(autoincrement())
  meetingId Int
  meeting   Meeting @relation(fields: [meetingId], references: [id])

  date DateTime

  createdAt DateTime @default(now())

  dateSelections DateSelection[]
}

// One DateSelection row per member per date option they are available for.
// Selections are saved together with the member's BookVote in one submission.
model DateSelection {
  id           Int        @id @default(autoincrement())
  dateOptionId Int
  dateOption   DateOption @relation(fields: [dateOptionId], references: [id])

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  submittedAt DateTime @default(now())

  @@unique([dateOptionId, memberId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// The club's shareable join link. Registration requires a valid one, and it
// can be used any number of times. Only the newest non-revoked link works;
// "resetting" the link revokes it and creates a new one. Old rows are kept
// as history.
model JoinLink {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  createdById Int?
  createdBy   Member?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// One-time password reset link sent by email. Only a SHA-256 hash of the
// token is stored, so a database leak can't be used to reset passwords.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
