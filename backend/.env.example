# Copy to backend/.env and fill in. Restart the backend after any change —
# settings (including email) are only read when the server starts.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/bookclub"

# Signs the login cookie. Use a long random value, and a different one in
# production. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

PORT=3001

# Where the frontend runs. Used for CORS and for the join/reset links the app
# hands out, so in production this must be the real site address.
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV=development

# ── Email (optional) ─────────────────────────────────────────────────────────
# Sends password reset links and feedback notifications through Gmail.
# GMAIL_APP_PASSWORD is a Google "app password", not your normal password:
# create one at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification). Without these, the app still runs; in development, reset
# links are printed in the backend's terminal instead of emailed.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Where feedback from the Help page is sent
FEEDBACK_TO_EMAIL=""
